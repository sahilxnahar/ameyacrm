{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "buildCommand": "npm run vercel-build",
  "installCommand": "npm install",
  "crons": [
    {
      "path": "/api/cron/daily",
      "schedule": "0 1 * * *"
    },
    {
      "path": "/api/cron/auto-release",
      "schedule": "0 1 * * *"
    },
    {
      "path": "/api/cron/escalate",
      "schedule": "0 * * * *"
    },
    {
      "path": "/api/cron/worker",
      "schedule": "*/15 * * * *"
    }
  ],
  "env": {
    "TZ": "Asia/Kolkata"
  },
  "build": {
    "env": {
      "TZ": "Asia/Kolkata"
    }
  }
}
